# Base URL of the Dungeon Walker server. There's no safe default here:
# - iOS Simulator: http://localhost:3000
# - Android Emulator: http://10.0.2.2:3000
# - Physical device (Expo Go): http://<your-computer's-LAN-IP>:3000
#
# Also used for map tiles now (GET {this}/tiles/{z}/{x}/{y}.pbf) — no
# separate map API key needed at all. See docs/maplibre-migration.md.
EXPO_PUBLIC_API_URL=http://localhost:3000
