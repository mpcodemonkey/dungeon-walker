# Base URL of the Dungeon Walker server. There's no safe default here:
# - iOS Simulator: http://localhost:3000
# - Android Emulator: http://10.0.2.2:3000
# - Physical device (Expo Go): http://<your-computer's-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Required for Android builds only (react-native-maps). Get one from
# Google Cloud Console with "Maps SDK for Android" enabled — see
# mobile/README.md for the full walkthrough. Not needed for iOS (Apple
# Maps is used there by default). Deliberately NOT prefixed with
# EXPO_PUBLIC_ — this is a native-build-time value, not something that
# should end up in the JS bundle.
ANDROID_GOOGLE_MAPS_API_KEY=
