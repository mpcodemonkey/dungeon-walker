generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  character Character?
}

// One character per user for now. Stat defaults are placeholders — real
// starting values (and how classes/gear modify them) land with the class
// system and combat balancing work.
model Character {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name  String
  level Int    @default(1)
  xp    Int    @default(0)

  strength     Int @default(5)
  agility      Int @default(5)
  focus        Int @default(5)
  intelligence Int @default(5)
  wisdom       Int @default(5)
  luck         Int @default(5)

  // Banked Activity Points: steps earned but not yet spent. Capped at
  // MAX_BANKED_AP (src/lib/constants.ts), does not decay over time.
  bankedAp Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activitySyncs ActivitySync[]
  encounters    Encounter[]
}

// Audit log of step-sync batches from the mobile client, not just a
// running counter — needed for anti-cheat review and future streak/daily
// stats features. See docs/chunk-3-movement.md.
model ActivitySync {
  id          String    @id @default(uuid())
  character   Character @relation(fields: [characterId], references: [id])
  characterId String

  stepCount        Int
  clientStartedAt  DateTime
  clientEndedAt    DateTime
  serverReceivedAt DateTime @default(now())

  latitude  Float?
  longitude Float?

  flagged    Boolean @default(false)
  flagReason String?

  @@index([characterId])
}

// Small placeholder bestiary — enough to prove the combat mechanic.
// Real enemy variety is a later content pass. See docs/chunk-4-combat.md.
model Enemy {
  id          String @id @default(uuid())
  name        String
  maxVitality Int
  xpReward    Int

  encounters Encounter[]
}

enum EncounterStatus {
  PENDING
  ACTIVE
  DEFEATED
  DESPAWNED
}

// Private per-character encounter instance (see docs/chunk-3-movement.md
// for the private-instance decision). One pending/active encounter per
// character at a time, enforced in application code, not a DB constraint.
model Encounter {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id])
  enemyId     String
  enemy       Enemy     @relation(fields: [enemyId], references: [id])

  currentVitality Int
  status          EncounterStatus @default(PENDING)

  spawnedAt  DateTime  @default(now())
  expiresAt  DateTime
  engagedAt  DateTime?
  resolvedAt DateTime?

  @@index([characterId])
}
