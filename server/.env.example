PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/dungeon_walker?schema=public"
# Generate a real secret for any non-throwaway environment, e.g.: openssl rand -hex 32
JWT_SECRET="dev-only-placeholder-change-me"
# Local path to a .pmtiles map data file, served by GET /tiles/:z/:x/:y.pbf.
# Optional — defaults to ./tiles/map.pmtiles. See docs/maplibre-migration.md
# for how to get one; server/test-fixtures/pmtiles has tiny fixtures for tests.
# PMTILES_PATH="./tiles/map.pmtiles"
